      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Downtime Root Cause Analysis",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "eg0mlercpd7ggc"
                      },
                      "spec": {
                        "query": "from(bucket: \"smartline_kpis\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  // Find all measurements that start with \"Alarm_\"\r\n  |> filter(fn: (r) => r[\"_measurement\"] =~ /^Alarm_/)\r\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\r\n  // Sum the 1s to get the total time/occurrences the alarm was active\r\n  |> sum() \r\n  // Group them by their measurement name so they appear as separate bars\r\n  |> group(columns: [\"_measurement\"])\r\n  // Sort from highest to lowest (Pareto style)\r\n  |> sort(columns: [\"_value\"], desc: true)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
